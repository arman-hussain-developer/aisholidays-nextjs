# Site URL (used for SEO, sitemap, canonical)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# SMTP credentials (use Gmail App Password OR any SMTP service like Brevo/Sendgrid/Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_app_password_here

# Enquiry delivery
MAIL_FROM="AiS Holidays <noreply@yourdomain.com>"
MAIL_TO=youremail@gmail.com
